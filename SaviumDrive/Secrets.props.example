<!--
    Claves de los servicios externos. Copia este archivo como Secrets.props (en esta misma carpeta)
    y rellénalo: git ignora Secrets.props, así que las claves nunca se suben al repositorio.

    Sin claves la app compila igual, pero no busca portadas en SteamGridDB ni puede iniciar sesión en Google.
    En GitHub Actions se pasan como variables de entorno con estos mismos nombres (secretos del repositorio).
-->
<Project>
  <PropertyGroup>
    <!-- https://www.steamgriddb.com/profile/preferences/api -->
    <SteamGridDbApiKey></SteamGridDbApiKey>

    <!-- Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (tipo "App de escritorio") -->
    <GoogleClientId></GoogleClientId>
    <GoogleClientSecret></GoogleClientSecret>
  </PropertyGroup>
</Project>
