<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>SaviumDrive</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>
		<Nullable>enable</Nullable>
		<!-- App sin empaquetar (sin MSIX): se distribuye como carpeta/.exe -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Incluir el runtime de Windows App SDK junto al .exe (el usuario no necesita instalar nada) -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>
	<!-- Sin las herramientas de C++ (MSVC) instaladas, el compilador XAML falla al buscarlas desde Visual Studio.
	     Este proyecto es solo C#, así que se omite esa búsqueda cuando no existen. -->
	<PropertyGroup Condition="'$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">
		<VCInstallPath32>none</VCInstallPath32>
		<VCInstallPath64>none</VCInstallPath64>
	</PropertyGroup>
	<ItemGroup>
		<Content Remove="Strings\en-US\Resources.resw" />
		<Content Remove="Strings\es-ES\Resources.resw" />
		<Content Remove="Themes\ThemeResources.xaml" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Themes\ThemeResources.xaml" />
		<None Remove="Views\AboutPage.xaml" />
		<None Remove="Views\AddGameDialog.xaml" />
		<None Remove="Views\BackupReminderWindow.xaml" />
		<None Remove="Views\ChangelogWindow.xaml" />
		<None Remove="Views\LibraryPage.xaml" />
		<None Remove="Views\SettingsPage.xaml" />
	</ItemGroup>
	<!-- PAQUETES NUGET -->
	<ItemGroup>
		<PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
		<PackageReference Include="Google.Apis.Drive.v3" Version="1.72.0.3970" />
		<!-- 1.8: corrige un cierre al arrancar desde rutas largas (corrupción de memoria en 1.6) -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Herramientas de compilación de recursos (PRI): permiten compilar sin el componente WinUI de Visual Studio -->
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
		<!-- ⬇️ NUEVO: Bandeja del sistema -->
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
	</ItemGroup>
	<ItemGroup>
		<!-- Imágenes e iconos: se copian junto al .exe -->
		<Content Include="Assets\StoreLogo.png" />
		<Content Include="Assets\tray-icon1024x1024.ico" />
		<Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\ChangelogWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\BackupReminderWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\AboutPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\LibraryPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\AddGameDialog.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup>
		<Page Update="Views\HomePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<!-- Publish Properties -->
	<PropertyGroup>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
		<PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
		<PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
		<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">false</PublishTrimmed>
		<ApplicationIcon>Assets\tray-icon1024x1024.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
	  <Optimize>True</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	  <Optimize>True</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
	  <Optimize>True</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <Optimize>True</Optimize>
	</PropertyGroup>
</Project>
