<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colores de la app para el tema claro y el oscuro. Las vistas los usan con {ThemeResource Nombre}
         y cambian solos al cambiar el tema (RequestedTheme de la ventana). -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- =========================
             TEMA CLARO (LIGHT)
             ========================= -->
        <ResourceDictionary x:Key="Light">
            <!-- Fondos -->
            <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="NavBackground" Color="#FFFFFF"/>

            <!-- Tarjetas -->
            <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ItemCardBackground" Color="#FFFFFF"/>

            <!-- Textos -->
            <SolidColorBrush x:Key="TextPrimary" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#505050"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#505050"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#808080"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#808080"/>

            <!-- Acentos -->
            <SolidColorBrush x:Key="AccentColor" Color="#008EFF"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#008EFF"/>

            <!-- BOTONES DE ACCIÓN (Agregar Juego) -->
            <SolidColorBrush x:Key="ActionBackground" Color="#008EFF"/>
            <SolidColorBrush x:Key="ActionHoverBackground" Color="#0078D4"/>
            <SolidColorBrush x:Key="ActionText" Color="white"/>

            <!-- Botón de cancelar (biblioteca durante una operación) -->
            <SolidColorBrush x:Key="CancelButtonBackground" Color="#C50F1F"/>
            <SolidColorBrush x:Key="CancelButtonHover" Color="#A80D19"/>
            <SolidColorBrush x:Key="CancelButtonText" Color="White"/>

            <!-- BOTONES ESTÁNDAR (Modales) -->
            <SolidColorBrush x:Key="StandardButtonBackground" Color="#F7F7F7"/>
            <SolidColorBrush x:Key="StandardButtonHover" Color="#E5E5E5"/>
            <SolidColorBrush x:Key="StandardButtonText" Color="#202020"/>
            <SolidColorBrush x:Key="StandardButtonBorder" Color="#D0D0D0"/>

            <SolidColorBrush x:Key="ListButtonHover" Color="#D5D5D5"/>

            <!-- Compatibilidad -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#008EFF"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#005A9E"/>
            <SolidColorBrush x:Key="ButtonText" Color="#FFFFFF"/>

            <!-- Estados -->
            <SolidColorBrush x:Key="DividerColor" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
            <SolidColorBrush x:Key="ErrorColor" Color="#C50F1F"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#C50F1F"/>

            <SolidColorBrush x:Key="RecentItemText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="RecentItemSecondaryText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CustomUpdateBrush" Color="#00bf63"/>

            <Color x:Key="UpdateBtnHoverTextColor">#202020</Color>
            <Color x:Key="UpdateBtnHoverBackgroundColor">#FFFFFF</Color>

            <SolidColorBrush x:Key="UpdateBtnText" Color="#FFFFFF"/>
        </ResourceDictionary>

        <!-- =========================
             TEMA OSCURO (DARK)
             ========================= -->
        <ResourceDictionary x:Key="Dark">
            <!-- Fondos -->
            <SolidColorBrush x:Key="AppBackground" Color="#151515"/>
            <SolidColorBrush x:Key="NavBackground" Color="#202020"/>

            <!-- Tarjetas -->
            <SolidColorBrush x:Key="CardBackground" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="ItemCardBackground" Color="#2D2D2D"/>

            <!-- Textos -->
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#D0D0D0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D0D0D0"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#909090"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#909090"/>

            <!-- Acentos -->
            <SolidColorBrush x:Key="AccentColor" Color="#008EFF"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#008EFF"/>

            <!-- BOTONES DE ACCIÓN -->
            <SolidColorBrush x:Key="ActionBackground" Color="#008EFF"/>
            <SolidColorBrush x:Key="ActionHoverBackground" Color="#0078D4"/>
            <SolidColorBrush x:Key="ActionText" Color="White"/>

            <!-- Botón de cancelar (biblioteca durante una operación) -->
            <SolidColorBrush x:Key="CancelButtonBackground" Color="#C50F1F"/>
            <SolidColorBrush x:Key="CancelButtonHover" Color="#A80D19"/>
            <SolidColorBrush x:Key="CancelButtonText" Color="White"/>

            <!-- BOTONES ESTÁNDAR -->
            <SolidColorBrush x:Key="StandardButtonBackground" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="StandardButtonHover" Color="#383838"/>
            <SolidColorBrush x:Key="StandardButtonText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="StandardButtonBorder" Color="#3C3C3C"/>

            <SolidColorBrush x:Key="ListButtonHover" Color="#353535"/>

            <!-- Compatibilidad -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#008EFF"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#0094C8"/>
            <SolidColorBrush x:Key="ButtonText" Color="#000000"/>

            <!-- Estados -->
            <SolidColorBrush x:Key="DividerColor" Color="#303030"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#6CCB5F"/>
            <SolidColorBrush x:Key="ErrorColor" Color="#FF4D4F"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF4D4F"/>

            <SolidColorBrush x:Key="RecentItemBackground" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="RecentItemText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="RecentItemSecondaryText" Color="#B8B8B8"/>

            <SolidColorBrush x:Key="CustomUpdateBrush" Color="#00bf63"/>

            <Color x:Key="UpdateBtnHoverTextColor">#FFFFFF</Color>
            <Color x:Key="UpdateBtnHoverBackgroundColor">#1F1F1F</Color>
            <SolidColorBrush x:Key="UpdateBtnText" Color="#FFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ========================================================
         ESTILOS DE BOTONES GLOBALES
         ======================================================== -->

    <!-- Estilo para el botón de ACCIÓN PRINCIPAL (Agregar Juego) -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ActionBackground}"/>
        <Setter Property="Foreground" Value="{ThemeResource ActionText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" 
                          Background="{TemplateBinding Background}" 
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ActionHoverBackground}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ActionHoverBackground}"/>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.6"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter" 
                                        Content="{TemplateBinding Content}" 
                                        ContentTemplate="{TemplateBinding ContentTemplate}" 
                                        Foreground="{TemplateBinding Foreground}" 
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                        Padding="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo del botón de CANCELAR -->
    <Style x:Key="CancelButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CancelButtonBackground}"/>
        <Setter Property="Foreground" Value="{ThemeResource CancelButtonText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" 
                          Background="{TemplateBinding Background}" 
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource CancelButtonHover}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource CancelButtonHover}"/>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.6"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter" 
                                        Content="{TemplateBinding Content}" 
                                        ContentTemplate="{TemplateBinding ContentTemplate}" 
                                        Foreground="{TemplateBinding Foreground}" 
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                        Padding="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>