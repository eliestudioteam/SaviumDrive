<Page
    x:Class="SaviumDrive.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SaviumDrive.Models"
    xmlns:views="using:SaviumDrive.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="5">
                <TextBlock x:Uid="LibTitle" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}"/>

                <StackPanel x:Name="SyncIndicator" Orientation="Vertical" Spacing="5" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TxtProgressTitle" x:Uid="LibSyncing" FontSize="12" Foreground="{ThemeResource AccentColor}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtProgressDetail" Text="" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressBar x:Name="MainProgressBar" Width="280" Height="4" VerticalAlignment="Center" Foreground="{ThemeResource AccentColor}" IsIndeterminate="True"/>
                        <TextBlock x:Name="TxtProgressPercent" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Buscar y ordenar -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <AutoSuggestBox x:Name="TxtBuscar" x:Uid="LibSearch" Width="260"
                                    QueryIcon="Find" TextChanged="TxtBuscar_TextChanged"/>
                    <ComboBox x:Name="CmbOrden" x:Uid="LibSort" MinWidth="200"
                              SelectionChanged="CmbOrden_SelectionChanged">
                        <ComboBoxItem x:Uid="LibSortNameAZ" Tag="NombreAZ"/>
                        <ComboBoxItem x:Uid="LibSortNameZA" Tag="NombreZA"/>
                        <ComboBoxItem x:Uid="LibSortRecent" Tag="UltimoBackup"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BtnMainAction" Grid.Column="1" Click="BtnMainAction_Click"
        Style="{StaticResource ActionButtonStyle}" 
        VerticalAlignment="Top">
                <StackPanel x:Name="BtnContentStack" Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="BtnIcon" Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    <TextBlock x:Name="BtnText" x:Uid="LibAddBtn" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <GridView x:Name="GamesGrid" Grid.Row="1" ItemsSource="{x:Bind Juegos}" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:GameConfig">
                    <Grid Width="160" Height="260" CornerRadius="8" Background="{ThemeResource ItemCardBackground}" Margin="0,0,15,15">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind RutaEnEstePc}"/>
                        </ToolTipService.ToolTip>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Portada; durante una subida o restauración va en gris y se colorea con el progreso (como Epic) -->
                        <views:CoverProgress Grid.Row="0" VerticalAlignment="Top" Height="210"
                                             CoverUri="{x:Bind SafeCoverUri}"
                                             Progress="{x:Bind ProgresoTarjeta, Mode=OneWay}"/>

                        <Border Grid.Row="0" VerticalAlignment="Bottom" Background="#CC000000" Padding="5">
                            <TextBlock Text="{x:Bind DisplayName}" Foreground="White" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Selector de versión activa (solo si hay más de una) -->
                        <ComboBox Grid.Row="0"
                                  x:Uid="CmbItemVersion"
                                  ItemsSource="{x:Bind OrderedVersions}"
                                  SelectedItem="{x:Bind ActiveVersion}"
                                  DisplayMemberPath="Label"
                                  Tag="{x:Bind}"
                                  SelectionChanged="CmbVersion_SelectionChanged"
                                  Visibility="{x:Bind HasMultipleVersions}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,6,6,0" MinWidth="64" Height="28" Padding="8,0,0,0"
                                  FontSize="11" FontWeight="SemiBold"
                                  Background="#CC000000" Foreground="White" BorderThickness="0">
                            <!-- Mismos colores en modo claro y oscuro: va sobre la portada, no sobre el fondo de la app -->
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="ComboBoxBackground" Color="#CC000000"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E6000000"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F2000000"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#CC000000"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#CC000000"/>
                                <SolidColorBrush x:Key="ComboBoxForeground" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="White"/>
                                <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="White"/>
                            </ComboBox.Resources>
                        </ComboBox>

                        <!-- La carpeta de partidas no existe en este PC (ej. el juego se agregó en otro equipo) -->
                        <Border Grid.Row="0" VerticalAlignment="Center" Margin="8,0"
                                Background="#E6202020" CornerRadius="6" Padding="8"
                                Visibility="{x:Bind NeedsRelink}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="CardFolderMissing" Foreground="White" FontSize="11"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <Button x:Uid="CardChooseFolder" Click="BtnRelink_Click" Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch" FontSize="11" Padding="6,4"
                                        Style="{StaticResource StandardBtnStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Progreso de la operación en curso (en lugar de los botones) -->
                        <TextBlock Grid.Row="1" Text="{x:Bind TextoProgresoTarjeta, Mode=OneWay}"
                                   Visibility="{x:Bind EnOperacion, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentColor}"/>

                        <!-- Acciones (sobre la versión activa) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Padding="2,5"
                                    Visibility="{x:Bind SinOperacion, Mode=OneWay}">

                            <!-- Botón Actualizar -->
                            <Button x:Uid="BtnItemUpdate"
                                    Click="BtnUpdate_Click" Tag="{x:Bind}"
                                    Width="30" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFA500"/>
                            </Button>

                            <!-- Botón Restaurar -->
                            <Button x:Uid="BtnItemRestore"
                                    Click="BtnRestore_Click" Tag="{x:Bind}"
                                    Width="30" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SuccessColor}"/>
                            </Button>

                            <!-- Botón Eliminar -->
                            <Button x:Uid="BtnItemDelete"
                                    Click="BtnDelete_Click" Tag="{x:Bind}"
                                    Width="30" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource ErrorColor}"/>
                            </Button>

                            <!-- Botón Nueva versión -->
                            <Button x:Uid="BtnItemNewVersion"
                                    Click="BtnNewVersion_Click" Tag="{x:Bind}"
                                    Width="30" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource AccentColor}"/>
                            </Button>

                            <!-- Botón Historial (solo si hay más de una versión) -->
                            <Button x:Uid="BtnItemHistory"
                                    Click="BtnHistory_Click" Tag="{x:Bind}"
                                    Visibility="{x:Bind HasMultipleVersions}"
                                    Width="30" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
                            </Button>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- La búsqueda no encontró juegos (pero la biblioteca no está vacía) -->
        <StackPanel x:Name="NoResultsState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
            <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{ThemeResource TextTertiary}"/>
            <TextBlock x:Uid="LibNoResults" Foreground="{ThemeResource TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Visibility="Collapsed">
            <FontIcon Glyph="&#xE7BC;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{ThemeResource TextTertiary}"/>
            <TextBlock x:Uid="LibEmptyTitle" Foreground="{ThemeResource TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Uid="LibEmptyDesc" Foreground="{ThemeResource TextTertiary}" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>