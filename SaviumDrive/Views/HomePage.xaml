<Page
    x:Class="SaviumDrive.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">

            <StackPanel Spacing="20" Padding="0,0,12,0">

                <TextBlock x:Uid="HomeTitle" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}"/>

                <Grid ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackground}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AccentColor}" FontSize="24"/>
                                <TextBlock x:Uid="CloudStatus" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtConnectionStatus" x:Uid="Connected" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtConnectionMessage" x:Uid="SyncReady" FontSize="12" Foreground="{ThemeResource SuccessColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackground}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AccentColor}" FontSize="24"/>
                                <TextBlock x:Uid="SavedGames" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGamesCount" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Uid="InLib" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource CardBackground}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE88E;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AccentColor}" FontSize="24"/>
                                <TextBlock x:Uid="DriveStorage" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtStorageUsed" Text="-" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>

                            <ProgressBar x:Name="StorageLoadingBar" IsIndeterminate="True" Height="4" Visibility="Collapsed"/>

                            <StackPanel Spacing="5">
                                <ProgressBar x:Name="StorageProgressBar" Value="0" Maximum="100" Height="6"/>
                                <TextBlock x:Name="TxtStorageRemaining" Text="-" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button x:Name="BtnQuickAddBackup" 
                        Click="BtnQuickAddBackup_Click"
                        Background="{ThemeResource ErrorBrush}" Foreground="White"
                        HorizontalAlignment="Center"
                        Padding="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock x:Uid="BtnQuickAddBackup" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Uid="RecentBackups" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" Margin="0,10,0,0"/>

                <Border Background="{ThemeResource CardBackground}" CornerRadius="8" Padding="20" MinHeight="100">
                    <Grid>
                        <StackPanel x:Name="EmptyRecentState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Visible">
                            <FontIcon Glyph="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{ThemeResource TextTertiary}"/>
                            <TextBlock x:Uid="NoActivity" Foreground="{ThemeResource TextSecondary}"/>
                        </StackPanel>

                        <StackPanel x:Name="RecentBackupsPanel" Spacing="15" Visibility="Collapsed">
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>