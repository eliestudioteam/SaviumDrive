<Window
    x:Class="SaviumDrive.Views.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="30,30,30,20">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{ThemeResource AccentColor}"/>
                    <TextBlock x:Uid="ChangelogTitle" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TxtVersionInfo" 
                          Text="Version 1.0.1" 
                          FontSize="14" 
                          Foreground="{ThemeResource TextSecondary}" 
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Changelog Content -->
        <ScrollViewer Grid.Row="1" Padding="30,0,30,20">
            <Border Background="{ThemeResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="25"
                    BorderBrush="{ThemeResource DividerColor}"
                    BorderThickness="1">
                <StackPanel Spacing="15">
                    <!-- Icono y mensaje de bienvenida -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ChangelogWelcome" 
                                 FontSize="16" 
                                 Foreground="{ThemeResource TextPrimary}" 
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerColor}" Margin="0,10,0,10"/>

                    <!-- Contenido del changelog -->
                    <RichTextBlock x:Name="ChangelogContent" 
                                 IsTextSelectionEnabled="True"
                                 Foreground="{ThemeResource TextSecondary}">
                        <Paragraph>
                            <Run Text="Loading changelog..."/>
                        </Paragraph>
                    </RichTextBlock>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer con botón -->
        <Grid Grid.Row="2" Background="{ThemeResource NavBackground}" Padding="30,20">
            <Button x:Name="BtnClose"
                    Click="BtnClose_Click"
                    Background="{ThemeResource ActionBackground}"
                    Foreground="{ThemeResource ActionText}"
                    Padding="40,12"
                    CornerRadius="20"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"/>
                    <TextBlock x:Uid="ChangelogCloseBtn" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>