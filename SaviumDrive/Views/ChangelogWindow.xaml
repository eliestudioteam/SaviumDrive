<Window
    x:Class="SaviumDrive.Views.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Raiz" Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de título (se puede arrastrar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="15,0,0,0">
                <Image Source="ms-appx:///Assets/StoreLogo.png" Width="16" Height="16"/>
                <TextBlock Text="Savium Drive" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- Cabecera -->
        <StackPanel Grid.Row="1" Padding="32,12,32,20" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AccentColor}">
                    <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="ChangelogTitle" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                    <TextBlock x:Name="TxtVersionInfo" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Uid="ChangelogWelcome" FontSize="14" Margin="0,8,0,0"
                       Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Notas de la versión -->
        <ScrollViewer Grid.Row="2" Padding="32,0,32,20" VerticalScrollBarVisibility="Auto">
            <Border Background="{ThemeResource CardBackground}" CornerRadius="12" Padding="24,18" VerticalAlignment="Top"
                    BorderBrush="{ThemeResource DividerColor}" BorderThickness="1">
                <RichTextBlock x:Name="ChangelogContent" IsTextSelectionEnabled="True" FontSize="14"
                               LineHeight="22" Foreground="{ThemeResource TextPrimary}" TextWrapping="Wrap"/>
            </Border>
        </ScrollViewer>

        <!-- Botones -->
        <Grid Grid.Row="3" Background="{ThemeResource NavBackground}" Padding="32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnGitHub" Click="BtnGitHub_Click" Style="{StaticResource StandardBtnStyle}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    <TextBlock x:Uid="ChangelogGitHubBtn"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnClose" Grid.Column="1" Click="BtnClose_Click" Style="{StaticResource ActionButtonStyle}" Padding="28,8">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape"/>
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    <TextBlock x:Uid="ChangelogCloseBtn" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
