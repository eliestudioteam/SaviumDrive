<Window
    x:Class="SaviumDrive.Views.BackupReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackground}" BorderBrush="{ThemeResource DividerColor}" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título -->
        <Grid x:Name="AppTitleBar" Background="Transparent" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="15,0,0,0">
                <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AccentColor}" FontSize="12"/>
                <!-- x:Uid para el título -->
                <TextBlock x:Uid="DetectorTitle" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- Contenido -->
        <StackPanel Grid.Row="1" Padding="20,10,20,20" Spacing="15" VerticalAlignment="Center">

            <!-- 🔥 TEXTO GENÉRICO TRADUCIDO -->
            <TextBlock x:Name="TxtMessage" 
                       x:Uid="DetectorMsg"
                       TextWrapping="Wrap"
                       FontSize="14" 
                       Foreground="{ThemeResource TextPrimary}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>

            <TextBlock x:Name="TxtSubMessage"
                       x:Uid="DetectorSubMsg"
                       TextWrapping="Wrap"
                       FontSize="12" 
                       Foreground="{ThemeResource TextSecondary}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- Botones -->
        <Grid Grid.Row="2" Background="{ThemeResource CardBackground}" Padding="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Botón NO -->
            <Button x:Name="BtnNo" Click="BtnNo_Click" Grid.Column="0" 
                    x:Uid="BtnNoConfig"
                    Style="{StaticResource StandardBtnStyle}" 
                    HorizontalAlignment="Stretch">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>

            <!-- Botón SÍ -->
            <Button x:Name="BtnYes" Click="BtnYes_Click" Grid.Column="2" 
                    x:Uid="BtnConfig"
                    Style="{StaticResource ActionButtonStyle}" 
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>